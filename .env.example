# URL base da API do ap-back-contratos. Ainda não consumida em nenhum lugar
# do código (o backend só tem endpoints de contrato a partir dos Planos
# 03-08) — só a configuração da conexão está preparada aqui.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# CNPJ (14 dígitos) do financiador usado nas chamadas a /contratos/<financiador_id>.
# Em produção isto viria de um contexto de sessão/tenant; por agora é fixo via env.
VITE_FINANCIADOR_ID=
