# Cada backend (ap-back-contratos, ap-back-optin, ap-back-consulta-agenda) é
# um serviço Django independente e roda na sua própria porta localmente —
# não podem todos usar :8000 ao mesmo tempo.

# URL base da API do ap-back-contratos. Consumida em src/services/contratosApi.ts.
# GET .../eventos exige JWT porque devolve os request/response crus trocados
# com a CERC, que incluem dados bancários do domicílio de pagamento; as
# demais rotas de contrato ainda não exigem (pendência conhecida do
# ap-back-contratos), mas o token é enviado em toda chamada mesmo assim.
VITE_CONTRATOS_API_BASE_URL=http://localhost:8000/api/v1
VITE_CONTRATOS_DEV_JWT=

# CNPJ (14 dígitos) do financiador usado nas chamadas a /contratos/<financiador_id>.
# Em produção isto viria de um contexto de sessão/tenant; por agora é fixo via env.
VITE_FINANCIADOR_ID=

# API do ap-back-optin (registro CERC de opt-in). JWT de desenvolvimento
# fixo — placeholder até existir login real; nunca usar em produção.
VITE_OPTIN_API_BASE_URL=http://localhost:8001/api/v1
VITE_OPTIN_DEV_JWT=

# API do agenda-service (ap-back-consulta-agenda). JWT de desenvolvimento
# fixo — placeholder até existir login real; nunca usar em produção.
VITE_AGENDA_API_BASE_URL=http://localhost:8002/api/v1
VITE_AGENDA_DEV_JWT=
